@page
@model wt_lab5_5razor_denisenko.Pages.Players.DetailsModel
@{
    ViewData["Title"] = "Профиль игрока";
}

@if (Model.Player is not null)
{
    <section class="page-intro"><div><div class="eyebrow">PLAYER DOSSIER / ID @Model.Player.Id.ToString("000")</div><h1>Профиль <span class="neon-cyan">игрока</span></h1><p>Данные участника и текущая соревновательная статистика.</p></div><a class="btn btn-ghost" asp-page="/Players/Index">← Все игроки</a></section>
    <section class="detail-panel">
        <div class="detail-hero"><div class="detail-avatar">@Model.Player.Nickname.Substring(0, 1).ToUpperInvariant()</div><div class="detail-identity"><span class="status-badge"><i></i> ПРОФИЛЬ В БАЗЕ</span><h2>@Model.Player.Nickname</h2><p>@Model.Player.Game</p></div><div class="detail-rating"><span>PLAYER RATING</span><strong>@Model.Player.Rating.ToString("N0")</strong><small>из 5 000</small></div></div>
        <div class="detail-metrics"><div><span>ПОБЕДЫ</span><strong class="neon-cyan">@Model.Player.Wins</strong></div><div><span>ПОРАЖЕНИЯ</span><strong class="neon-pink">@Model.Player.Losses</strong></div><div><span>WIN RATE</span><strong>@Model.Player.WinRate.ToString("0.#")%</strong></div><div><span>ID УЧАСТНИКА</span><strong>#@Model.Player.Id.ToString("000")</strong></div></div>
        <div class="detail-info"><div><span>Игровая дисциплина</span><strong>@Model.Player.Game</strong></div><div><span>Дата регистрации</span><strong>@Model.Player.CreatedAt.ToString("dd.MM.yyyy")</strong></div><div><span>Статус</span><strong class="neon-cyan">Зарегистрирован</strong></div></div>
        <div class="detail-actions"><a class="btn btn-neon" asp-page="/Players/Edit" asp-route-id="@Model.Player.Id">Редактировать профиль</a><form method="post" asp-page-handler="Delete" asp-route-id="@Model.Player.Id" onsubmit="return confirm('Вы уверены, что хотите удалить профиль? Это действие нельзя отменить.');"><button type="submit" class="btn btn-danger-ghost">Удалить профиль</button></form><a class="btn btn-ghost" asp-page="/Players/Index">Назад к списку</a></div>
    </section>
}
